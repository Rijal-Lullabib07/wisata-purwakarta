# [TEMPLATE] — Salin file ini menjadi `.env` lalu isi sesuai project Supabase kamu.
# Kunci dapat dari: Supabase Dashboard > Project Settings > API
# Catatan: file `.env` ASLI sengaja TIDAK di-commit (lihat .gitignore).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key-kamu>

# Opsional — Cloudflare Turnstile untuk captcha halaman admin (site key boleh publik).
# Kosongkan dulu jika belum setup; login admin tetap jalan tanpa ini.
VITE_TURNSTILE_SITE_KEY=
